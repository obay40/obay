# =============================================================================
# Autoklick24 – Environment Variables (Beispiel)
# Diese Datei enthält KEINE echten Secrets. Für lokale Entwicklung kopieren
# nach ".env" und Werte anpassen.
# =============================================================================

# --- App -------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Datenbank ---------------------------------------------------------------
DATABASE_URL="postgresql://autoklick24:autoklick24@localhost:5432/autoklick24?schema=public"

# --- Auth ----------------------------------------------------------------
AUTH_SECRET="change-me-in-production-min-32-chars"
AUTH_URL="http://localhost:3000"

# --- Object Storage (S3-kompatibel, z. B. MinIO/Cloudflare R2) -------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="autoklick24-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/autoklick24-dev"

# --- E-Mail (transaktional) ------------------------------------------------
EMAIL_PROVIDER_KEY=""
EMAIL_FROM="Autoklick24 <no-reply@autoklick24.de>"

# =============================================================================
# Spätere Integrationen (noch nicht aktiv, nur vorbereitet)
# =============================================================================

# --- Payments (Phase 10) ----------------------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Fahrzeugbewertung / Marktdaten (später, aktuell Mock-Provider) --------
# VALUATION_API_KEY=""

# --- Fahrzeugdaten per Kennzeichen/VIN/HSN-TSN (später, aktuell Mock) ------
# VEHICLE_DATA_API_KEY=""

# --- Suchengine (später, aktuell Postgres-Queries) --------------------------
# SEARCH_ENGINE_URL=""
# SEARCH_ENGINE_API_KEY=""

# --- SMS / Push (später) ----------------------------------------------------
# SMS_PROVIDER_KEY=""
# FCM_SERVER_KEY=""
# APNS_KEY_ID=""
